# =========================================================
# Multi-Lab Python & NLP/LLM Ignore Rules
# =========================================================

# Virtual Environments & Secrets (Root and all sub-lab folders)
.env
.env.*
*.env
.venv/
*/.venv/
**/.venv/
venv/
*/venv/
**/venv/
env/
*/env/
**/env/
ENV/
*/ENV/
**/ENV/

# Python Byte-compiled / optimized / DLL files
__pycache__/
*/__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/
**/.ipynb_checkpoints/
*/.ipynb_checkpoints/*
**/.ipynb_checkpoints/*

# Local NLP Data / Model Caches & Large Weights
nltk_data/
*/nltk_data/
**/nltk_data/
.spacy_cache/
*/.spacy_cache/
**/.spacy_cache/
downloads/
*/downloads/
**/downloads/
temp/
*/temp/
**/temp/
%temp%/
*/%temp%/
**/%temp%/
*.pt
*.bin
*.safetensors
*.onnx
*.h5
*.ckpt

# Distribution / packaging
build/
develop-eggs/
dist/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
*.zip

# Unit test & coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/

# IDE / Editor Files
.idea/
*/.idea/
**/.idea/
.vscode/
*/.vscode/
**/.vscode/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
